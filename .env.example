# =============================================================================
# Portfolio Environment Configuration (.env.example)
# =============================================================================

# Contact Form Email Dispatch (https://resend.com)
# When set, all contact inquiries are formatted as rich HTML emails and
# dispatched directly to your inbox with a one-click reply-to header.
RESEND_API_KEY=

# Verified sender address on Resend (must use your verified domain @ariefsatria.my.id)
# Options:
# - Portfolio Contact <contact@ariefsatria.my.id>
# - Arief Satria <contact@ariefsatria.my.id>
# - Portfolio System <noreply@ariefsatria.my.id>
RESEND_FROM_EMAIL=Portfolio Contact <contact@ariefsatria.my.id>

# The private inbox that receives the contact inquiries (e.g., your personal Gmail)
CONTACT_RECIPIENT_EMAIL=your-email@example.com

# Optional: Publicly displayed direct contact email (leave empty to hide mailto links)
NUXT_PUBLIC_CONTACT_EMAIL=
